name: sa-screener-bot

on:
  schedule:
    # تشغيل كل 5 دقائق من الساعة 10:00 صباحاً وحتى 15:35 عصراً بتوقيت السعودية (UTC 07:00 إلى 12:35)
    # الأيام: من الأحد (0) إلى الخميس (4)
    - cron: "*/5 7-12 * * 0-4"
  workflow_dispatch:
    inputs:
      session:
        description: "Force a session for testing: regular / final_check (leave empty for automatic)"
        required: false
        default: ""

concurrency:
  group: sa-screener-bot
  cancel-in-progress: false

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install tradingview-screener requests

      # الاحتفاظ بملف seen.json بين الجولات لعدم تكرار التنبيهات
      - name: Restore seen tickers
        uses: actions/cache@v4
        with:
          path: seen.json
          key: seen-${{ github.run_id }}
          restore-keys: |
            seen-

      - name: Run bot
        env:
          BOT_TOKEN: ${{ secrets.BOT_TOKEN }}
          CHAT_ID: ${{ secrets.CHAT_ID }}
          FORCE_SESSION: ${{ inputs.session || github.event.inputs.session }}
        run: python main.py
